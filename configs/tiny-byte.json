{
  "model": {
    "architecture": "decoder_only_transformer",
    "vocab_size": 257,
    "context_length": 256,
    "n_layers": 4,
    "n_heads": 4,
    "embedding_dim": 128,
    "feed_forward_dim": 512,
    "normalization": "layer_norm",
    "activation": "gelu",
    "dropout": 0.1,
    "tie_token_embeddings": true,
    "dtype": "float32"
  },
  "tokenizer": {
    "type": "byte",
    "byte_token_min": 0,
    "byte_token_max": 255,
    "end_of_document_id": 256
  },
  "training": {
    "seed": 1337,
    "batch_size": 16,
    "sequence_length": 256,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "warmup_steps": 100,
    "weight_decay": 0.1,
    "gradient_clip_norm": 1.0,
    "max_steps": 5000,
    "validation_fraction": 0.05,
    "test_fraction": 0.05
  }
}
